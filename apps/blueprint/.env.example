# Required by Prisma CLI migrations and the server-only PostgreSQL composition root.
DATABASE_URL=postgresql://creatoros:replace-me@localhost:5432/creatoros

# Required by the destructive PostgreSQL integration suite. Use an isolated database.
TEST_DATABASE_URL=postgresql://creatoros:replace-me@localhost:5432/creatoros_test

# Google OpenID Connect (openid, email, profile only).
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3002/api/auth/google/callback
APP_BASE_URL=http://localhost:3002
AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
