generator client {
  provider     = "prisma-client"
  output       = "../core/persistence/prisma/generated"
  moduleFormat = "esm"
  runtime      = "nodejs"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
}

model AnalysisRunRow {
  analysisRunId        String    @id @map("analysis_run_id") @db.VarChar(255)
  creatorId            String    @map("creator_id") @db.VarChar(255)
  channelId            String    @map("channel_id") @db.VarChar(255)
  status               String    @db.VarChar(16)
  schemaVersion        Int       @map("schema_version")
  revision             Int
  source               Json
  adapterMetadata      Json?     @map("adapter_metadata")
  adapterWarnings      Json      @map("adapter_warnings")
  pipelineVersion      String    @map("pipeline_version") @db.VarChar(255)
  analysisResult       Json?     @map("analysis_result")
  failure              Json?
  correlationId        String?   @map("correlation_id") @db.VarChar(255)
  attempt              Int
  retryOfAnalysisRunId String?   @map("retry_of_analysis_run_id") @db.VarChar(255)
  createdAt            DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @map("updated_at") @db.Timestamptz(3)
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(3)

  @@index([channelId, createdAt(sort: Desc), analysisRunId(sort: Asc)], map: "analysis_runs_channel_history_idx")
  @@index([channelId, status, createdAt(sort: Desc), analysisRunId(sort: Asc)], map: "analysis_runs_channel_status_history_idx")
  @@map("analysis_runs")
}

model UserRow {
  userId          String              @id @map("user_id") @db.VarChar(255)
  email           String              @unique(map: "users_email_key") @db.VarChar(320)
  displayName     String              @map("display_name") @db.VarChar(255)
  locale          String              @db.VarChar(8)
  timezone        String?             @db.VarChar(100)
  status          String              @db.VarChar(16)
  createdAt       DateTime            @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @map("updated_at") @db.Timestamptz(3)
  identities      IdentityRow[]
  sessions        SessionRow[]
  youtubeIdentity YouTubeIdentityRow?

  @@map("users")
}

model YouTubeIdentityRow {
  youtubeIdentityId String           @id @map("youtube_identity_id") @db.VarChar(255)
  userId            String           @unique(map: "youtube_identities_user_key") @map("user_id") @db.VarChar(255)
  provider          String           @db.VarChar(32)
  providerUserId    String           @map("provider_user_id") @db.VarChar(255)
  channelId         String           @unique(map: "youtube_identities_channel_key") @map("channel_id") @db.VarChar(255)
  channelTitle      String           @map("channel_title") @db.VarChar(255)
  scopes            String[]
  state             String           @db.VarChar(16)
  createdAt         DateTime         @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @map("updated_at") @db.Timestamptz(3)
  revokedAt         DateTime?        @map("revoked_at") @db.Timestamptz(3)
  user              UserRow          @relation(fields: [userId], references: [userId], onDelete: Cascade)
  token             YouTubeTokenRow?

  @@index([providerUserId], map: "youtube_identities_provider_user_idx")
  @@map("youtube_identities")
}

model YouTubeTokenRow {
  tokenId               String             @id @map("token_id") @db.VarChar(255)
  youtubeIdentityId     String             @unique(map: "youtube_tokens_identity_key") @map("youtube_identity_id") @db.VarChar(255)
  encryptedRefreshToken String             @map("encrypted_refresh_token") @db.Text
  encryptedAccessToken  String?            @map("encrypted_access_token") @db.Text
  accessTokenExpiresAt  DateTime?          @map("access_token_expires_at") @db.Timestamptz(3)
  encryptionKeyId       String             @map("encryption_key_id") @db.VarChar(64)
  createdAt             DateTime           @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @map("updated_at") @db.Timestamptz(3)
  identity              YouTubeIdentityRow @relation(fields: [youtubeIdentityId], references: [youtubeIdentityId], onDelete: Cascade)

  @@map("youtube_tokens")
}

model IdentityRow {
  identityId      String   @id @map("identity_id") @db.VarChar(255)
  userId          String   @map("user_id") @db.VarChar(255)
  provider        String   @db.VarChar(32)
  providerSubject String   @map("provider_subject") @db.VarChar(255)
  status          String   @db.VarChar(16)
  createdAt       DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @map("updated_at") @db.Timestamptz(3)
  user            UserRow  @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([provider, providerSubject], map: "identities_provider_subject_key")
  @@index([userId, createdAt(sort: Asc)], map: "identities_user_idx")
  @@map("identities")
}

model SessionRow {
  sessionId      String    @id @map("session_id") @db.VarChar(255)
  userId         String    @map("user_id") @db.VarChar(255)
  tokenHash      String    @unique(map: "sessions_token_hash_key") @map("token_hash") @db.Char(64)
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  lastActivityAt DateTime  @map("last_activity_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  metadata       Json
  user           UserRow   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc), sessionId(sort: Asc)], map: "sessions_user_history_idx")
  @@index([expiresAt], map: "sessions_expiration_idx")
  @@map("sessions")
}
